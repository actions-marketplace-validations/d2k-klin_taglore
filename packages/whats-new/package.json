{
  "name": "@taglore/whats-new",
  "version": "0.1.0",
  "description": "React What's New dialog for release notes generated by Taglore. Works with Next.js App Router.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d2k-klin/taglore.git",
    "directory": "packages/whats-new"
  },
  "keywords": ["whats-new", "release-notes", "changelog", "react", "nextjs", "taglore"],
  "sideEffects": ["*.css"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": ["dist", "styles.css", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

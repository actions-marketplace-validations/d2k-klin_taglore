{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "taglore-evidence"
    },
    "product": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "previousVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "releaseType": {
      "type": "string",
      "enum": [
        "major",
        "minor",
        "patch",
        "prerelease",
        "unreleased"
      ]
    },
    "commit": {
      "type": "string"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "generatedAt": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "taglore"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "compare": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "release",
        "compare"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceMode": {
          "type": "string"
        },
        "statements": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unverified": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reused": {
          "type": "boolean"
        },
        "styleIssues": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "contextTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "evidenceMode",
        "statements",
        "unverified",
        "reused",
        "styleIssues",
        "contextTruncated"
      ],
      "additionalProperties": false
    },
    "security": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "open": {
              "type": "object",
              "properties": {
                "critical": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "high": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "medium": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "low": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "negligible": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "unknown": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "critical",
                "high",
                "medium",
                "low",
                "negligible",
                "unknown"
              ],
              "additionalProperties": false
            },
            "introduced": {
              "type": "object",
              "properties": {
                "critical": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "high": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "medium": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "low": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "negligible": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "unknown": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "critical",
                "high",
                "medium",
                "low",
                "negligible",
                "unknown"
              ],
              "additionalProperties": false
            },
            "fixed": {
              "type": "object",
              "properties": {
                "critical": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "high": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "medium": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "low": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "negligible": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "unknown": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "critical",
                "high",
                "medium",
                "low",
                "negligible",
                "unknown"
              ],
              "additionalProperties": false
            },
            "components": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "added": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "removed": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "changed": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "added",
                "removed",
                "changed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "open",
            "introduced",
            "fixed",
            "components"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "support": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "until": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contact": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(https:\\/\\/|mailto:)"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sbom": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https:\\/\\/"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "until",
            "contact",
            "sbom"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "mediaType": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "sha256",
          "bytes",
          "mediaType"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "product",
    "version",
    "previousVersion",
    "releaseType",
    "commit",
    "repository",
    "generatedAt",
    "generator",
    "links",
    "notes",
    "security",
    "support",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/d2k-klin/taglore/main/schema/evidence.schema.json",
  "title": "Taglore release evidence index"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "highlights": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 600
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "improvements": {
      "default": [],
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 600
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "fixes": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 600
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "breaking": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 600
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "previousVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "releaseType": {
      "type": "string",
      "enum": [
        "major",
        "minor",
        "patch",
        "prerelease"
      ]
    },
    "announce": {
      "type": "boolean"
    },
    "date": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "tagore"
        },
        "version": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "provider",
        "model"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "summary",
    "highlights",
    "improvements",
    "fixes",
    "breaking",
    "schemaVersion",
    "version",
    "previousVersion",
    "releaseType",
    "announce",
    "date",
    "generator"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/d2k-klin/tagore/main/schema/release.schema.json",
  "title": "Tagore release notes"
}
